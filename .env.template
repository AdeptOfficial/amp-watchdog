# amp-watchdog configuration — copy to .env and fill in
TZ=America/Chicago
LOG_LEVEL=INFO

# In Docker the compose file overrides this to /config/watchdog.db
DATABASE_URL=sqlite:///./data/watchdog.db

# AMP ADS panel + read-only service account (per-instance Manage permission only)
AMP_BASE_URL=http://amp.example.lan:8080
AMP_USERNAME=status-reader
AMP_PASSWORD=

# Scheduler granularity (seconds between due-watch sweeps) and default per-watch interval
SCHEDULER_TICK=5
DEFAULT_CHECK_INTERVAL=60
